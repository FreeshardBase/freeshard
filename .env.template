FREESHARD_DIR=/srv/freeshard # absolute path where all shard data is stored; created on first start, owned by root
DNS_ZONE=localhost  # your domain; the shard is reachable at <shard_id>.<DNS_ZONE>. Keep "localhost" for a local test
EMAIL=user@example.com  # contact address for Let's Encrypt certificates (not the owner's address)
DISABLE_SSL=false # true only for a local test without certificates, never on a server reachable from the internet
EMAIL_ENABLED=false # keep false: a self-hosted shard cannot send mail, so the owner address is taken without a confirmation mail
